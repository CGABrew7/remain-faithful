NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
BACKEND_URL=https://api.remainfaithful.com
# Shared with the API (SITE_PROXY_SECRET). When set, the site sends the visitor
# address so API limits apply per visitor. Leave unset to keep the previous behavior.
SITE_PROXY_SECRET=
# Optional. Keeps daily unique visitor counts stable across restarts.
# Generate with: openssl rand -hex 32
ANALYTICS_SALT=
NEXT_PUBLIC_SITE_URL=https://remainfaithful.com
# Stripe Checkout success/cancel URLs are not taken from this value.
# Production always returns to https://www.remainfaithful.com.

# Stripe — required for donation checkout
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...

# Cloudflare Turnstile. Leave both unset until the widget exists.
# Site key: Vercel (website). Secret: Vercel for the site API routes, and Fly
# for POST /contact and POST /waitlist on the Go API. Same secret value is fine.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
